{
  "name": "@cinatra-ai/blog-idea-artifact",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "files": [
    "src",
    "skills"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^4.0.0"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "artifact",
    "displayName": "Blog Idea",
    "roles": [
      "artifact-blog-idea-summary"
    ],
    "dependencies": [],
    "artifact": {
      "accepts": {
        "file": {
          "mimeTypes": [
            "text/markdown",
            "text/plain"
          ]
        }
      },
      "skills": {
        "authoring": [
          "@cinatra-ai/blog-idea-artifact:blog-idea-author"
        ],
        "matchers": [
          "@cinatra-ai/blog-idea-artifact:blog-idea-matcher"
        ]
      },
      "matcherConfidenceThreshold": 0.7,
      "objectTypes": [
        {
          "type": "@cinatra-ai/blog-idea-artifact:blog-idea",
          "claim": "dedicated",
          "dispositions": {
            "projection": "artifact-safe",
            "sensitivity": "normal"
          },
          "schema": {
            "type": "object",
            "properties": {
              "title": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      ]
    }
  }
}
